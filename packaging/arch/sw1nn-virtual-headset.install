_reload_rules() {
  udevadm control --reload-rules
  udevadm trigger
}

post_install() {
  _reload_rules

  cat <<'EOF'
==> Add your user to the input group, then log out and back in:
      sudo usermod -aG input $USER

==> Enable the user service in your session:
      systemctl --user enable --now virtual-headset

==> Firefox bridge:
      /usr/share/virtual-headset-firefox/install-native-host.sh
      then load /usr/share/virtual-headset-firefox/extension via
      about:debugging -> This Firefox -> Load Temporary Add-on
EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  _reload_rules
}
